# SmartService Platform Environment Configuration Template
# Copy this file to '.env' and populate with your environment values before running docker-compose up.

# Application Profile
SPRING_PROFILES_ACTIVE=prod

# PostgreSQL Database Configuration
POSTGRES_DB=smartservicedb
POSTGRES_USER=smartuser
POSTGRES_PASSWORD=YOUR_STRONG_DATABASE_PASSWORD_HERE

# Backend Database Connection
DATABASE_URL=jdbc:postgresql://postgres:5432/smartservicedb
DATABASE_USERNAME=smartuser
DATABASE_PASSWORD=YOUR_STRONG_DATABASE_PASSWORD_HERE

# Security & Authentication Secrets
# Generate a secure 256-bit key using: openssl rand -hex 32
JWT_SECRET=YOUR_64_CHARACTER_HEX_JWT_SECRET_KEY_HERE

# CORS & Payment Configuration
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:80
PAYMENT_KEY_ID=YOUR_RAZORPAY_KEY_ID
PAYMENT_KEY_SECRET=YOUR_RAZORPAY_KEY_SECRET
